# Server-only (used by api/contact.js). Never prefix with REACT_APP_ or it will be exposed to the browser.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Optional: also email each message via Web3Forms (public key, safe in the frontend)
REACT_APP_WEB3FORMS_ACCESS_KEY=
